{
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": true,
    "cmake.debugConfig": {
        "cwd": "${workspaceFolder}"
    },
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.cStandard": "c11",
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp",
        "*.cpp": "cpp",
        "iosfwd": "cpp",
        "atomic": "cpp",
        "charconv": "cpp",
        "cstdlib": "cpp",
        "system_error": "cpp",
        "type_traits": "cpp",
        "xlocale": "cpp",
        "xutility": "cpp",
        "cmath": "cpp"
    }
}
